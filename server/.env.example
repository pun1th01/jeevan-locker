PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/jeevan-locker
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_ORIGIN=http://localhost:5173
# Leave unset when clients hit the API directly. Behind a reverse proxy set the hop count (usually 1),
# "loopback", or a comma-separated IP/CIDR list. "true" is refused at startup (spoofable audit IPs).
TRUST_PROXY=
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
# Use a funded key printed by `npx hardhat node`; never use a real wallet key.
BLOCKCHAIN_PRIVATE_KEY=
# Both addresses are printed by `npm run chain:deploy`. At boot the server checks each configured address
# actually holds contract code and refuses to start if it does not (a bare address would silently accept
# transactions that register nothing).
DOCUMENT_REGISTRY_ADDRESS=
# Write-once registry for audit-event digests (consent transitions, emergency grants). Unset = anchoring
# stays queued (PENDING) until configured.
AUDIT_ANCHOR_ADDRESS=
# Key-encryption key for documents at rest: exactly 32 bytes, base64 or hex. REQUIRED; no dev fallback.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing this key loses every encrypted document. Back it up outside the repo.
DOCUMENT_MASTER_KEY=
# Label recorded on each document so a future key rotation knows which master key wrapped its data key.
DOCUMENT_MASTER_KEY_ID=primary
# Boot reconciliation of audit anchors scans consents/emergency grants for missing anchor rows.
# 0 (default) = scan everything; set a number of days to bound the scan once the collections are large.
ANCHOR_RECONCILE_WINDOW_DAYS=0
# Break-glass limits. Cap on live grants one doctor may hold at once, and how long after a patient
# revokes that a new grant on the same document is flagged `afterRevocation` (audited and notified).
EMERGENCY_MAX_ACTIVE_GRANTS=5
EMERGENCY_REGRANT_WINDOW_HOURS=24
