PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/jeevan-locker
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_ORIGIN=http://localhost:5173
# Leave unset when clients hit the API directly. Behind a reverse proxy set the hop count (usually 1),
# "loopback", or a comma-separated IP/CIDR list. "true" is refused at startup (spoofable audit IPs).
TRUST_PROXY=
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
# Use a funded key printed by `npx hardhat node`; never use a real wallet key.
BLOCKCHAIN_PRIVATE_KEY=
DOCUMENT_REGISTRY_ADDRESS=
# Key-encryption key for documents at rest: exactly 32 bytes, base64 or hex. REQUIRED; no dev fallback.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing this key loses every encrypted document. Back it up outside the repo.
DOCUMENT_MASTER_KEY=
# Label recorded on each document so a future key rotation knows which master key wrapped its data key.
DOCUMENT_MASTER_KEY_ID=primary
