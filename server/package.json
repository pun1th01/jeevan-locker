{
  "name": "server",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "seed:demo": "tsx src/utils/seedDemoUsers.ts",
    "create:admin": "tsx src/scripts/createUser.ts --role admin",
    "create:lab": "tsx src/scripts/createUser.ts --role lab",
    "migrate:encrypt": "tsx src/scripts/encryptExistingDocuments.ts",
    "verify:anchors": "tsx src/scripts/verifyAnchorPreimages.ts",
    "chain": "hardhat node",
    "chain:compile": "hardhat compile",
    "chain:deploy": "hardhat run scripts/deploy-document-registry.js --network localhost",
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck:test": "tsc -p tsconfig.test.json"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "ethers": "^6.17.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.6.2",
    "multer": "^2.1.1"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^3.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.9.0",
    "@types/supertest": "^7.2.1",
    "hardhat": "^2.22.0",
    "mongodb-memory-server": "^11.1.0",
    "supertest": "^7.3.0",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.22.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2"
  }
}
